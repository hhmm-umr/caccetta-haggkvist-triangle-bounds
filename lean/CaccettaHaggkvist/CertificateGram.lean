module

public import CaccettaHaggkvist.VanillaCertBridge
public import CaccettaHaggkvist.WeightedFlags

/-! # Exact Gram blocks for compiled flag certificates

The lookup functions may be generated by any program. The checker proves every
matrix entry from nonnegative integral weights and signed integral factors.
Flag labels outside the block's dimension give zero on both sides.
-/

@[expose] public section

namespace CaccettaHaggkvist

def sumInt (f : ℕ → ℤ) : ℕ → ℤ
  | 0 => 0
  | n+1 => Int.add (sumInt f n) (f n)

theorem sumInt_eq (f : ℕ → ℤ) (n : ℕ) : sumInt f n = ∑ i ∈ Finset.range n, f i := by
  induction n with
  | zero => simp [sumInt]
  | succ n ih => rw [sumInt, ih, Finset.sum_range_succ]; rfl

structure CertificateGram where
  dim : ℕ
  rank : ℕ
  flagId : ℕ → ℕ
  weight : ℕ → ℕ
  entry : ℕ → ℕ → ℤ
  factor : ℕ → ℕ → ℤ

namespace CertificateGram

def check (B : CertificateGram) : Bool :=
  allBelow B.dim fun i => allBelow B.dim fun j =>
    decide (B.entry i j = sumInt (fun t => (B.weight t : ℤ) * B.factor t i * B.factor t j) B.rank)

def value (B : CertificateGram) (l r : ℕ) : ℤ :=
  let i := B.flagId l
  let j := B.flagId r
  if i < B.dim ∧ j < B.dim then B.entry i j else 0

def coordinate (B : CertificateGram) (t l : ℕ) : ℤ :=
  let i := B.flagId l
  if i < B.dim then B.factor t i else 0

theorem expand (B : CertificateGram) (hb : B.check = true) (l r : ℕ) :
    (B.value l r : ℝ) = ∑ t ∈ Finset.range B.rank,
      (B.weight t : ℝ) * (B.coordinate t l : ℝ) * (B.coordinate t r : ℝ) := by
  by_cases hl : B.flagId l < B.dim <;> by_cases hr : B.flagId r < B.dim
  · have e := of_allBelow (of_allBelow hb hl) hr
    have dot := of_decide_eq_true e
    rw [sumInt_eq] at dot
    simp only [value, coordinate, hl, hr, and_self, ite_true]
    exact_mod_cast dot
  all_goals simp [value, coordinate, hl, hr]

noncomputable def bound (B : CertificateGram) (t : ℕ) : ℝ :=
  ∑ i ∈ Finset.range B.dim, |(B.factor t i : ℝ)|

theorem coordinate_le (B : CertificateGram) (t l : ℕ) :
    |(B.coordinate t l : ℝ)| ≤ B.bound t := by
  by_cases h : B.flagId l < B.dim
  · simp only [coordinate, h, ↓reduceIte, bound]
    exact Finset.single_le_sum (fun i _ => abs_nonneg (B.factor t i : ℝ)) (Finset.mem_range.mpr h)
  · simp only [coordinate, h, ↓reduceIte, Int.cast_zero, abs_zero, bound]
    exact Finset.sum_nonneg (s := Finset.range B.dim) (fun i _ => abs_nonneg (B.factor t i : ℝ))

noncomputable def loss (B : CertificateGram) : ℝ :=
  ∑ t ∈ Finset.range B.rank, (B.weight t : ℝ) * (B.bound t)^2

theorem loss_nonneg (B : CertificateGram) : 0 ≤ B.loss :=
  Finset.sum_nonneg (fun t _ => mul_nonneg (Nat.cast_nonneg (B.weight t)) (sq_nonneg _))

noncomputable def term {k d e : ℕ} (B : CertificateGram)
    (A : OrientedGraph (Fin (k+e)) → ℝ) (H : OrientedGraph (Fin (k+d+d+e))) : ℝ :=
  A (H.pullback (WeightedFlag.localizer k d e)) *
    (B.value (graphTritCode (H.pullback (WeightedFlag.left k d e)))
      (graphTritCode (H.pullback (WeightedFlag.right k d e))) : ℝ)

/-- Once the finite Gram check has passed, the expectation bound holds on every host graph. -/
theorem expectation_ge {W : Type*} [Fintype W] {k d e : ℕ} (B : CertificateGram)
    (hb : B.check = true) {w : W → ℝ} (hw : IsProbWeight w) (G : OrientedGraph W)
    (A : OrientedGraph (Fin (k+e)) → ℝ) {err : ℝ} (he : 0 ≤ err)
    (hA : ∀ x, -err ≤ WeightedFlag.mean w G A x) :
    -B.loss * err ≤ ∑ x : Fin (k+d+d+e) → W, tupleWeight w x * B.term A (G.pullback x) := by
  let F (t : ℕ) (H : OrientedGraph (Fin (k+d))) : ℝ := (B.coordinate t (graphTritCode H) : ℝ)
  have expandTerm (H : OrientedGraph (Fin (k+d+d+e))) :
      B.term A H = ∑ t ∈ Finset.range B.rank, (B.weight t : ℝ) * WeightedFlag.term A (F t) H := by
    rw [term, B.expand hb, Finset.mul_sum]
    exact Finset.sum_congr rfl (fun t _ => by unfold WeightedFlag.term; dsimp [F]; ring)
  simp_rw [expandTerm, Finset.mul_sum]
  rw [Finset.sum_comm]
  unfold loss
  calc
    -(∑ t ∈ Finset.range B.rank, (B.weight t : ℝ) * B.bound t ^ 2) * err =
        ∑ t ∈ Finset.range B.rank, (B.weight t : ℝ) * (-(B.bound t)^2 * err) := by
          rw [neg_mul, Finset.sum_mul, ← Finset.sum_neg_distrib]
          exact Finset.sum_congr rfl (fun t _ => by ring)
    _ ≤ _ := by
      refine Finset.sum_le_sum fun t _ => ?_
      have h := WeightedFlag.expectation_ge hw G A (F t) he
        (fun K => B.coordinate_le t (graphTritCode K)) (fun x => Or.inr (hA x))
      calc (B.weight t : ℝ) * (-(B.bound t)^2 * err) ≤
            (B.weight t : ℝ) * ∑ x : Fin (k+d+d+e) → W,
              tupleWeight w x * WeightedFlag.term A (F t) (G.pullback x) :=
            mul_le_mul_of_nonneg_left h (Nat.cast_nonneg _)
           _ = _ := by
            rw [Finset.mul_sum]
            exact Finset.sum_congr rfl (fun x _ => by ring)

end CertificateGram
end CaccettaHaggkvist
